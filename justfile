default:
    @just --list

# create a virtualenv and install the project with dev dependencies
init:
    python3 -m venv .venv
    .venv/bin/pip install -e ".[dev]"

# start levelkeeper via docker compose (internal scheduler)
run:
    docker compose up -d --build

# run the test suite
test:
    .venv/bin/pytest

# format the codebase
format:
    .venv/bin/ruff format .

# lint the codebase
lint:
    .venv/bin/ruff check .

# create a tag with the next version, auto generated by git cliff
[no-cd]
bump-version push="":
    #!/usr/bin/env bash
    export VERSION="$( git cliff --bumped-version )"
    git tag -m "$VERSION" "$VERSION"
    git log HEAD~1..HEAD

    if [[ "{{push}}" = "push" ]]; then
        git push origin $VERSION
    fi

# generate and aggregate a changelog from the last tag
[no-cd]
changelog:
    git cliff --latest > CHANGELOG.md
